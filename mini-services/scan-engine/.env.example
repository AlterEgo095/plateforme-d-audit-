# ── AuditForge — configuration du moteur d'exécution (scan-engine) ──────────
# Copiez ce fichier vers `.env` puis adaptez les valeurs :
#   cp .env.example .env

# Base de données SQLite partagée avec l'application Next.js.
# Chemin relatif résolu depuis mini-services/scan-engine/prisma/schema.prisma ;
# en cas de doute, utilisez un chemin ABSOLU (recommandé).
DATABASE_URL="file:/opt/auditforge/db/custom.db"

# Secret de signature des sessions (HMAC-SHA256) — DOIT être identique à
# celui de l'application Next.js (vérification des handshakes socket.io).
AUTH_SECRET="changez-moi-openssl-rand-hex-32"

# Token interne exigé sur /internal/* (en-tête `x-internal-token`) —
# DOIT être identique à celui de l'application Next.js.
ENGINE_INTERNAL_TOKEN="changez-moi-openssl-rand-hex-32"

# Interface d'écoute HTTP. Défaut : 127.0.0.1 (bouclage, le plus sûr).
# En Docker, mettre 0.0.0.0 — le port n'est alors jamais publié sur l'hôte.
# BIND_HOST=127.0.0.1

# Port d'écoute du moteur. Défaut : 3030.
# PORT=3030

# ── Exécution réelle des outils (Phantom, Basalt) ───────────────────────────
# simulation : pipelines simulés uniquement (aucune cible touchée) — défaut ;
# auto       : réel si l'outil est disponible (binaire + Docker), sinon
#              simulation avec une ligne de journal explicite ;
# real       : réel strict — le scan passe en FAILED si l'outil est absent.
TOOL_EXECUTION_MODE="auto"

# Binaires (surcharge possible si installation hors PATH)
# PHANTOM_BIN="phantom"        # pip install phantom-agent (sandbox Docker Kali)
# BASALT_BIN="basalt"          # pipx install basalt-scan (sandbox Docker PoC)

# LLM des outils réels — endpoint OpenAI-compatible :
#   - pont local AuditForge : http://127.0.0.1:3031/v1 (mini-service llm-bridge)
#   - Z.ai direct : https://api.z.ai/api/paas/v4
#   - tout autre endpoint OpenAI-compatible (Ollama local, etc.)
LLM_API_BASE="http://127.0.0.1:3031/v1"
LLM_API_KEY=""
# Modèle LiteLLM transmis à Phantom (provider/model)
PHANTOM_LLM="openai/glm-4.6"
# Modèle transmis à Basalt
BASALT_MODEL="glm-4.6"

# Timeout global d'un scan réel (minutes)
REAL_SCAN_TIMEOUT_MIN="180"
