# ── AuditForge — configuration principale (application Next.js) ─────────────
# Copiez ce fichier vers `.env` puis adaptez les valeurs :
#   cp .env.example .env

# ── Base de données (SQLite via Prisma) ─────────────────────────────────────
# Chemin relatif résolu depuis prisma/schema.prisma ; en cas de doute,
# utilisez un chemin ABSOLU (recommandé en développement local).
DATABASE_URL="file:/opt/auditforge/db/custom.db"

# ── Sécurité ────────────────────────────────────────────────────────────────
# Secret de signature des sessions (HMAC-SSHA256, cookie `af_session`).
# OBLIGATOIRE en production. Générez-en un avec :  openssl rand -hex 32
AUTH_SECRET="changez-moi-openssl-rand-hex-32"

# Token interne exigé par le moteur d'exécution sur /internal/*
# (en-tête `x-internal-token`). DOIT être identique côté moteur.
# Générez-en un avec :  openssl rand -hex 32
ENGINE_INTERNAL_TOKEN="changez-moi-openssl-rand-hex-32"

# ── Comptes au premier démarrage (C2 — audit 8-a) ───────────────────────────
# Les identifiants de DÉMONSTRATION (admin/Admin123!) ne sont créés qu'en
# DÉVELOPPEMENT LOCAL (défaut hors production) ou si DEMO_SEED=1 — ils ne sont
# plus affichés dans l'interface de connexion. Aucun TOTP de démonstration
# n'existe. Amorçage production recommandé : définissez le premier compte ADMIN
# ci-dessous (sans MFA — activez-en un ensuite), puis créez les autres via
# l'interface.
# DEMO_SEED="0"
# ADMIN_USERNAME="chefprojet"
# ADMIN_PASSWORD="un-mot-de-passe-fort-unique"

# Cookie de session : 1 = toujours Secure, 0 = jamais. Défaut : détection
# automatique via X-Forwarded-Proto (HTTPS derrière Caddy ⇒ Secure).
# COOKIE_SECURE="1"

# ── Moteur d'exécution ──────────────────────────────────────────────────────
# URL du mini-service scan-engine consommée par l'API Next.js (côté serveur).
# Développement local : http://127.0.0.1:3030  |  Docker : http://engine:3030
ENGINE_URL="http://127.0.0.1:3030"

# ── Exécution réelle des outils (Phantom, Basalt) ───────────────────────────
# simulation : pipelines simulés (aucune cible touchée) — défaut ;
# auto       : réel si l'outil est disponible (binaire + Docker), sinon simulation ;
# real       : réel strict — scan en échec si l'outil est indisponible.
TOOL_EXECUTION_MODE="auto"

# Plafond global de scans simultanés (protection du VPS : Docker, RAM, outils).
# P4 : au-delà de ce plafond, les scans sont MIS EN FILE D'ATTENTE (plus de
# rejet) — une campagne à plusieurs outils démarre toujours.
MAX_CONCURRENT_SCANS="3"
# Capacité de la file d'attente moteur (P4) — au-delà : rejet explicite.
MAX_QUEUED_SCANS="100"

# Rétention des journaux de scan (P3) : lignes de terminal (ScanLog) purgées
# au-delà de N jours (balayage au boot puis chaque 24 h). Les constats et le
# journal d'audit ne sont jamais supprimés. 0 désactive. Défaut : 30.
LOG_RETENTION_DAYS="30"

# LLM des outils réels — endpoint OpenAI-compatible :
#   Z.ai direct : https://api.z.ai/api/paas/v4  (+ votre clé ci-dessous)
#   pont local  : http://127.0.0.1:3031/v1  (mini-service llm-bridge)
LLM_API_BASE="http://127.0.0.1:3031/v1"
LLM_API_KEY=""
PHANTOM_LLM="openai/glm-4.6"
BASALT_MODEL="glm-4.6"
# Compresseur mémoire de Phantom (résumé du contexte) — même modèle que
# PHANTOM_LLM recommandé (défaut amont sans préfixe provider → erreurs litellm).
PHANTOM_COMPRESSOR_LLM=""
# Image sandbox Kali de Phantom (vide = défaut amont ghcr.io/usta0x001/…).
# En Docker Compose, l'image enrichie locale : auditforge/phantom-sandbox-plus.
PHANTOM_IMAGE=""
REAL_SCAN_TIMEOUT_MIN="180"

# ── P5 « Arsenal » — outils evergreen (adaptateurs réels génériques) ────────
# Les 11 binaires sont détectés dans le PATH du conteneur MOTEUR ; sans
# installation, chaque outil reste honnêtement signalé indisponible (vue
# Outils) et le mode auto bascule en simulation. Surcharges possibles :
# SUBFINDER_BIN="subfinder"        # go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
# AMASS_BIN="amass"                # go install github.com/owasp-amass/amass/v4/cmd/amass@latest
# HTTPX_BIN="httpx"                # go install github.com/projectdiscovery/httpx/cmd/httpx@latest
# NUCLEI_BIN="nuclei"              # go install github.com/projectdiscovery/nuclei/v2/cmd/nuclei@latest
# NIKTO_BIN="nikto"                # apt install nikto
# ZAP_COMMAND="zap-baseline.py"    # OWASP ZAP (automation framework) — image zaproxy/zap-stable
# ── RF2 (audit v2) : ZAP en side-car compose (RECOMMANDÉ en production) ──
# Définissez ZAP_API_URL pour que le moteur pilote le daemon ZAP via son API
# REST (spider → passif → actif → alertes) : exécution réelle SANS binaire
# local. Le service compose `zap` (profil « zap ») le fournit :
#   docker compose -f scripts/docker-compose.prod.yml --profile zap up -d
# Vide (défaut) → mode binaire zap-baseline.py (simulation s'il manque).
# ZAP_API_URL="http://zap:8080"
# ZAP_API_KEY="openssl-rand-hex-32-obligatoire-avec-le-sidecar"
# SEMGREP_BIN="semgrep"            # pipx install semgrep
# SEMGREP_CONFIG="auto"            # "auto" (registre, réseau requis) ou chemin de règles local
# TRIVY_BIN="trivy"                # apt/brew install trivy
# GITLEAKS_BIN="gitleaks"          # brew install gitleaks / binaire GitHub releases
# SQLMAP_BIN="sqlmap"              # apt install sqlmap / pip install sqlmap
# FFUF_BIN="ffuf"                  # go install github.com/ffuf/ffuf/v2@latest
# Wordlist ffuf (manquante → repli /usr/share/wordlists/dirb/common.txt)
# FFUF_WORDLIST="/usr/share/seclists/Discovery/Web-Content/common.txt"

# ── Hub DefectDojo (P5 — centralisation des résultats) ──────────────────────
# Export GET /api/reports/dojo?campaignId=… : aucune configuration requise.
# Push optionnel (POST /api/reports/dojo) vers votre instance DefectDojo :
# DOJO_API_URL="http://defectdojo:8080"
# DOJO_API_TOKEN="token-api-v2-defectdojo"
# DOJO_ENGAGEMENT_ID="123"

# ── Plateformes distantes : DeepAudit et RedAmon (adaptateurs API réels) ─────
# Déployez chaque plateforme (docker compose de son dépôt — voir README) puis
# déclarez la connexion ; sans ces variables, ces outils restent en simulation
# (badge honnête dans la vue Outils).
# DEEPAUDIT_API_URL="http://deepaudit-backend:8000"
# DEEPAUDIT_EMAIL="auditforge@exemple.com"
# DEEPAUDIT_PASSWORD="mot-de-passe-deepaudit"
# REDAMON_API_URL="http://redamon-webapp:3000"
# REDAMON_EMAIL="auditforge@exemple.com"
# REDAMON_PASSWORD="mot-de-passe-redamon"

# ── CORS socket.io (moteur, déploiement Docker) ───────────────────
# URL publique du site — autorisée pour les handshakes socket.io.
# Vide (développement local derrière la gateway) : comportement réflexif.
# SITE_ORIGIN="https://audit.exemple.com"

# ── Déploiement Docker Compose ─────────────────────────────────
# Reverse proxy Caddy : ports exposés + domaine (HTTPS automatique si défini).
# HTTP_PORT="80"
# HTTPS_PORT="443"
# SITE_DOMAIN="audit.exemple.com"

# ── Limites de ressources par conteneur (P2 — audit v2) ─────────────────────
# Plafonds souples appliqués dans docker-compose*.yml. Défauts :
#   app 512m / 1.0 CPU · engine 2g / 2.0 CPU · caddy 256m / 1.0 CPU · backup 128m
#   · zap 2g / 1.5 CPU (side-car, JVM DAST).
# NB : les SANDBOXES de scan (Phantom/Basalt) sont des conteneurs du DÉMON
# hôte — hors de ces plafonds. Pour bornes l'empreinte globale des scans,
# ajustez plutôt MAX_CONCURRENT_SCANS ci-dessus.
# APP_MEM_LIMIT="512m"
# APP_CPUS="1.0"
# ENGINE_MEM_LIMIT="2g"
# ENGINE_CPUS="2.0"
# CADDY_MEM_LIMIT="256m"
# CADDY_CPUS="1.0"
# BACKUP_MEM_LIMIT="128m"
# ZAP_MEM_LIMIT="2g"
# ZAP_CPUS="1.5"

# Docker des sandboxes (moteur) — développement local SANS compose : laissez
# vide (socket par défaut du démon). Avec compose (P0.3) : le moteur passe par
# le proxy filtrant, DOCKER_HOST est posé dans le compose — ne pas redéfinir.
# DOCKER_HOST=""

# ── Sauvegarde planifiée (P1 — sidecar `backup`, docker-compose.prod.yml) ────
# Répertoire HÔTE recevant les sauvegardes (survivent à `compose down -v`),
# rotation et période. Restauration : scripts/auditforge-restore.sh.
# BACKUP_HOST_DIR="/opt/auditforge/backups"
# BACKUP_KEEP="7"
# BACKUP_INTERVAL_SECONDS="86400"

# ── Pont LLM local optionnel (mini-service llm-bridge, port 3031) ────
# Clé exigée par le pont si LLM_BRIDGE_KEY est défini côté pont.
# LLM_BRIDGE_KEY=""
