# ── AuditForge — configuration du pont LLM (llm-bridge) ──────────────────────
# Copiez ce fichier vers `.env` puis adaptez les valeurs :
#   cp .env.example .env
#
# Le pont expose /v1/chat/completions (protocole OpenAI) adossé à Z.ai.
# En production sur VPS, vous pouvez soit utiliser ce pont, soit pointer les
# outils directement vers l'API Z.ai (https://api.z.ai/api/paas/v4).

# Clé d'accès exigée par le pont (en-tête Authorization: Bearer <clé>).
# Laissez vide en développement local (réseau bouclage uniquement).
# Générez-en une avec :  openssl rand -hex 32
LLM_BRIDGE_KEY=""

# Modèle par défaut transmis à Z.ai si la requête n'en précise pas.
LLM_BRIDGE_MODEL="glm-4.6"

# Liste de modèles exposés via GET /v1/models (séparés par des virgules).
LLM_BRIDGE_MODELS="glm-4.6,glm-4.5-air,glm-4.5-flash"
