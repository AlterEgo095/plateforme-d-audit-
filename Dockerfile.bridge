# ── AuditForge — image du pont LLM v2 (mini-services/llm-bridge, port 3031) ──
# Proxy OpenAI-compatible multi-upstreams : rotation round-robin des modèles
# découverts dynamiquement + failover cooldown + re-découverte périodique.
# Aucune dépendance runtime (Bun fetch natif).
# Build :  docker build -f Dockerfile.bridge -t auditforge-llm-bridge .
# Run    :  BIND_HOST=0.0.0.0 (réseau interne compose + publication hôte
#           restreinte — voir docker-compose.yml : 172.17.0.1 uniquement).

FROM oven/bun:1-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

# Code source (zéro dépendance → pas d'étape bun install)
COPY mini-services/llm-bridge/src ./src

EXPOSE 3031

CMD ["bun", "src/index.ts"]
