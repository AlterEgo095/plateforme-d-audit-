# ── AuditForge — image du moteur d'exécution (mini-services/scan-engine) ────
# Service socket.io + API interne /internal/* + ADAPTATEURS D'EXÉCUTION RÉELLE
# (Phantom, Basalt installés via pip — leurs sandbox utilisent le socket Docker
# de l'hôte : monter /var/run/docker.sock au déploiement, voir docker-compose).

# ── 1) Dépendances Bun + génération du client Prisma ────────────────────────
FROM oven/bun:1 AS build
WORKDIR /engine
# Le schéma est requis avant l'installation (postinstall @prisma/client).
COPY mini-services/scan-engine/package.json mini-services/scan-engine/bun.lock ./
COPY mini-services/scan-engine/prisma ./prisma
RUN bun install --frozen-lockfile
COPY mini-services/scan-engine/src ./src
RUN bunx prisma generate

# ── 2) Exécution : Python 3.12 (outils réels) + Bun (moteur) ────────────────
FROM python:3.12-slim AS runner
WORKDIR /engine
ENV NODE_ENV=production PYTHONUNBUFFERED=1

# Outils système : openssl (moteurs Prisma), git (clonage des cibles GIT),
# ca-certificates (TLS vers l'API LLM), curl+gnupg (repo Docker pour le CLI).
# Le SDK Python `docker` (dépendance des outils) pilote la sandbox via
# /var/run/docker.sock ; le CLI `docker` est requis par la sonde de
# disponibilité (probeVersion) des adaptateurs Phantom/Basalt.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates git curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# CLI Docker seul (pas de démon) : le démon utilisé est celui de l'HÔTE via
# /var/run/docker.sock — aucun service n'est démarré dans ce conteneur.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Outils d'audit réels (Phantom — sandbox Kali, Basalt — sandbox PoC sans réseau).
# Attention : le premier scan Phantom tire l'image sandbox (~13 Go, une seule fois).
RUN pip install --no-cache-dir phantom-agent basalt-scan

# Correctif amont (phantom-agent 0.9.218, dernière version publiée) : dans
# interface/cli.py, un `import sys` LOCAL (bloc json_mode, ligne ~448) masque
# l'import global (ligne 4) : au chemin d'échec de l'agent, `sys.exit(1)` lève
# UnboundLocalError (« cannot access local variable 'sys' ») qui écrase le vrai
# message d'erreur et fait échouer le CLI avec le code 1 « et aucun constat ».
# Suppression du import local — la portée globale suffit ; l'erreur réelle de
# l'agent est alors affichée (« Penetration test failed: … ») avant la sortie.
RUN sed -i '/^            import sys$/d' \
      /usr/local/lib/python3.12/site-packages/phantom/interface/cli.py

# Correctif amont n°2 (phantom-agent 0.9.218) : `_resolve_docker_host()`
# retourne « 127.0.0.1 » — or la sandbox publie son port tool-server sur
# l'HÔTE : depuis le conteneur moteur, 127.0.0.1 ne l'expose jamais →
# « Tool server failed to start / Container initialization timed out » à
# chaque scan réel (~144 s de healthchecks en échec). On retourne
# host.docker.internal, résolu vers la passerelle hôte par extra_hosts
# (service engine, docker-compose.override.yml).
RUN sed -i 's/^        return "127\.0\.0\.1"$/        return "host.docker.internal"/' \
      /usr/local/lib/python3.12/site-packages/phantom/runtime/docker_runtime.py

# Correctif amont n°3 (phantom-agent 0.9.218) : les listes `priority_tools`
# des profils standard/deep (phantom/core/scan_profiles.py) n'annoncent pas
# les outils ajoutés dans la sandbox enrichie (PHANTOM_IMAGE=
# auditforge/phantom-sandbox-plus — voir Dockerfile.sandbox). On étend ces
# listes (injectées dans le prompt des agents) avec les binaires réellement
# installés. quick/stealth/api_only restent volontairement inchangés
# (périmètre minimal : CI/CD, furtivité, API).
RUN sed -i 's/priority_tools=\["nmap", "httpx", "nuclei", "sqlmap", "ffuf", "nikto"\]/priority_tools=["nmap", "httpx", "nuclei", "sqlmap", "ffuf", "nikto", "whatweb", "gobuster", "testssl.sh", "xsstrike", "commix", "wpscan", "dalfox", "zaproxy", "hydra"]/' \
      /usr/local/lib/python3.12/site-packages/phantom/core/scan_profiles.py \
 && sed -i 's/priority_tools=\["nmap", "httpx", "nuclei", "sqlmap"\]/priority_tools=["nmap", "httpx", "nuclei", "sqlmap", "nikto", "whatweb", "gobuster", "testssl.sh", "xsstrike", "commix", "wpscan", "dalfox", "zaproxy"]/' \
      /usr/local/lib/python3.12/site-packages/phantom/core/scan_profiles.py

# Bun (binaire autonome) + code du moteur (client Prisma généré inclus).
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
COPY --from=build /engine /engine

EXPOSE 3030

# BIND_HOST est fourni par docker-compose (0.0.0.0 dans le réseau interne
# compose uniquement — le port n'est jamais publié sur l'hôte).
# exec direct (sans `bun run`) : SIGTERM délivré au processus → arrêt gracieux.
CMD ["bun", "src/index.ts"]

# ── Santé (P2 audit v2) ─────────────────────────────────────────────────────
# /internal/health exige le token interne (contrat K.1) : il est fourni au
# conteneur par docker-compose (ENGINE_INTERNAL_TOKEN, même valeur que l'app)
# et développé par le shell AU RUNTIME (jamais inscrit dans l'image).
# curl échoue (exit ≠ 0) sur timeout, connexion refusée ou statut ≥ 400
# (401 = token faux → conteneur signalé unhealthy, caddy ne démarrera pas).
# curl est installé plus haut (repo Docker CLI). start_period couvre le boot
# (bun + connexion Prisma) ; interval 15 s ≈ détection d'un moteur bloqué < 1 min.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -sf -H "x-internal-token: ${ENGINE_INTERNAL_TOKEN}" \
        http://127.0.0.1:3030/internal/health || exit 1
