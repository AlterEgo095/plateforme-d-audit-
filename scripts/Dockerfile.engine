# ── AuditForge — image du moteur d'exécution (mini-services/scan-engine) ────
# Service socket.io + API interne /internal/* + ADAPTATEURS D'EXÉCUTION RÉELLE
# (Phantom, Basalt installés via pip — leurs sandbox utilisent le socket Docker
# de l'hôte : monter /var/run/docker.sock au déploiement, voir docker-compose).

# ── 0) RF2 (audit v2) : étage de build des outils Go (multi-stage) ─────────
# Les 5 binaires projectdiscovery/OWASP/ffuf sont compilés dans un étage
# DÉDIÉ (golang:1.23-alpine) : le runner final ne contient NI toolchain Go NI
# cache de modules — image plus légère, couches reconstructibles, build Go
# mis en cache indépendamment du code moteur. WITH_ARSENAL=0 (défaut) saute
# la compilation : /arsenal-bin reste vide, aucune binaire copié.
# NB : golang:1-alpine (et non 1.23) — les outils @latest (subfinder v2.17,
# nuclei v3, amass v4…) montent régulièrement leur go.mod minimum ; épingler
# une version cassait le build à chaque montée amont. GOTOOLCHAIN=auto laisse
# la toolchain se télécharger seule si un module exige encore plus récent.
FROM golang:1-alpine AS go-builder
ENV GOTOOLCHAIN=auto
ARG WITH_ARSENAL=0
RUN mkdir -p /arsenal-bin
RUN if [ "$WITH_ARSENAL" = "1" ]; then set -eux; \
      GOBIN=/arsenal-bin go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
      && GOBIN=/arsenal-bin go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest \
      && GOBIN=/arsenal-bin go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
      && GOBIN=/arsenal-bin go install -v github.com/owasp-amass/amass/v4/cmd/amass@latest \
      && GOBIN=/arsenal-bin go install -v github.com/ffuf/ffuf/v2@latest; \
    fi

# ── 1) Dépendances Bun + génération du client Prisma ────────────────────────
FROM oven/bun:1 AS build
WORKDIR /engine
# Le schéma est requis avant l'installation (postinstall @prisma/client).
COPY mini-services/scan-engine/package.json mini-services/scan-engine/bun.lock ./
COPY mini-services/scan-engine/prisma ./prisma
RUN bun install --frozen-lockfile
COPY mini-services/scan-engine/src ./src
RUN bunx prisma generate

# ── 2) Exécution : Python 3.12 (outils réels) + Bun (moteur) ────────────────
FROM python:3.12-slim AS runner
WORKDIR /engine
ENV NODE_ENV=production PYTHONUNBUFFERED=1

# Outils système : openssl (moteurs Prisma), git (clonage des cibles GIT),
# ca-certificates (TLS vers l'API LLM), curl+gnupg (repo Docker pour le CLI).
# Le SDK Python `docker` (dépendance des outils) pilote la sandbox via
# /var/run/docker.sock ; le CLI `docker` est requis par la sonde de
# disponibilité (probeVersion) des adaptateurs Phantom/Basalt.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates git curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# CLI Docker seul (pas de démon) : le démon utilisé est celui de l'HÔTE via
# /var/run/docker.sock — aucun service n'est démarré dans ce conteneur.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Outils d'audit réels (Phantom — sandbox Kali, Basalt — sandbox PoC sans réseau).
# Attention : le premier scan Phantom tire l'image sandbox (~13 Go, une seule fois).
RUN pip install --no-cache-dir phantom-agent basalt-scan

# Correctif amont (phantom-agent 0.9.218, dernière version publiée) : dans
# interface/cli.py, un `import sys` LOCAL (bloc json_mode, ligne ~448) masque
# l'import global (ligne 4) : au chemin d'échec de l'agent, `sys.exit(1)` lève
# UnboundLocalError (« cannot access local variable 'sys' ») qui écrase le vrai
# message d'erreur et fait échouer le CLI avec le code 1 « et aucun constat ».
# Suppression du import local — la portée globale suffit ; l'erreur réelle de
# l'agent est alors affichée (« Penetration test failed: … ») avant la sortie.
RUN sed -i '/^            import sys$/d' \
      /usr/local/lib/python3.12/site-packages/phantom/interface/cli.py

# Correctif amont n°2 (phantom-agent 0.9.218) : `_resolve_docker_host()`
# retourne « 127.0.0.1 » — or la sandbox publie son port tool-server sur
# l'HÔTE : depuis le conteneur moteur, 127.0.0.1 ne l'expose jamais →
# « Tool server failed to start / Container initialization timed out » à
# chaque scan réel (~144 s de healthchecks en échec). On retourne
# host.docker.internal, résolu vers la passerelle hôte par extra_hosts
# (service engine, docker-compose.override.yml).
RUN sed -i 's/^        return "127\.0\.0\.1"$/        return "host.docker.internal"/' \
      /usr/local/lib/python3.12/site-packages/phantom/runtime/docker_runtime.py

# Correctif amont n°2bis (P0.3bis — audit plateforme v2) : la version actuelle
# de `_resolve_docker_host()` lit DOCKER_HOST et en retourne le HOSTNAME.
# Avec le proxy socket Docker (DOCKER_HOST=tcp://docker-proxy:2375), phantom
# cherchait le tool-server de la sandbox sur « docker-proxy:48081 » — le
# proxy n'expose que l'API 2375 → ~144 s de healthchecks en échec → run
# « completed » à 0 requête LLM → exit 1 sans JSON final (« JSON final
# illisible » côté moteur). On force host.docker.internal (l'hôte, où la
# sandbox publie ses ports via 0.0.0.0) quelle que soit la valeur de
# DOCKER_HOST ; host.docker.internal est résolu par extra_hosts (override).
RUN sed -i 's/^                return parsed\.hostname$/                return "host.docker.internal"/' \
      /usr/local/lib/python3.12/site-packages/phantom/runtime/docker_runtime.py

# Correctif amont n°3 (phantom-agent 0.9.218) : les listes `priority_tools`
# des profils standard/deep (phantom/core/scan_profiles.py) n'annoncent pas
# les outils ajoutés dans la sandbox enrichie (PHANTOM_IMAGE=
# auditforge/phantom-sandbox-plus — voir Dockerfile.sandbox). On étend ces
# listes (injectées dans le prompt des agents) avec les binaires réellement
# installés. quick/stealth/api_only restent volontairement inchangés
# (périmètre minimal : CI/CD, furtivité, API).
RUN sed -i 's/priority_tools=\["nmap", "httpx", "nuclei", "sqlmap", "ffuf", "nikto"\]/priority_tools=["nmap", "httpx", "nuclei", "sqlmap", "ffuf", "nikto", "whatweb", "gobuster", "testssl.sh", "xsstrike", "commix", "wpscan", "dalfox", "zaproxy", "hydra"]/' \
      /usr/local/lib/python3.12/site-packages/phantom/core/scan_profiles.py \
 && sed -i 's/priority_tools=\["nmap", "httpx", "nuclei", "sqlmap"\]/priority_tools=["nmap", "httpx", "nuclei", "sqlmap", "nikto", "whatweb", "gobuster", "testssl.sh", "xsstrike", "commix", "wpscan", "dalfox", "zaproxy"]/' \
      /usr/local/lib/python3.12/site-packages/phantom/core/scan_profiles.py

# ── 3) P5 « Arsenal » — outils evergreen (OPTIONNEL, activé par build-arg) ──
# docker build --build-arg WITH_ARSENAL=1 -t auditforge/engine …
# Installe les 11 piliers open source (recon / DAST / SAST-SCA / exploitation)
# dans l'image du moteur. Sans ce build-arg, les outils restent en simulation
# (disponibilité honnête — sonde par binaire).
# RF2 : les binaires Go viennent de l'étage go-builder (multi-stage) ; le
# runner n'ajoute que les outils non-Go (apt : nikto/sqlmap ; pip : semgrep ;
# releases : trivy/gitleaks) puis copie les binaires Go si WITH_ARSENAL=1.
ARG WITH_ARSENAL=0
RUN if [ "$WITH_ARSENAL" = "1" ]; then set -eux; \
      apt-get update -y \
      && apt-get install -y --no-install-recommends sqlmap wget unzip libnet-ssleay-perl libxml-writer-perl \
      && pip install --no-cache-dir semgrep \
      && TRIVY_URL="$( (wget -qO- https://api.github.com/repos/aquasecurity/trivy/releases/latest || true) | sed -n 's/.*"browser_download_url": *"\(https:[^"]*Linux-64bit\.tar\.gz\)".*/\1/p' | head -1)" \
      && [ -n "$TRIVY_URL" ] \
      && wget -qO /tmp/trivy.tgz "$TRIVY_URL" \
      && tar -xzf /tmp/trivy.tgz -C /usr/local/bin trivy && rm /tmp/trivy.tgz \
      && git clone --depth 1 https://github.com/sullo/nikto.git /opt/nikto \
      && ln -sf /opt/nikto/program/nikto.pl /usr/local/bin/nikto \
      && chmod 0755 /opt/nikto/program/nikto.pl \
      && nikto -Version \
      && GL_VER="$( (wget -qO- https://api.github.com/repos/gitleaks/gitleaks/releases/latest || true) | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -1)" \
      && if [ -z "$GL_VER" ]; then GL_VER="$(git ls-remote --tags https://github.com/gitleaks/gitleaks.git | grep -v '\^{}' | sed 's/.*refs\/tags\/v//' | grep -E '^[0-9][0-9.]*$' | sort -V | tail -1)"; fi \
      && [ -n "$GL_VER" ] \
      && wget -qO /tmp/gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${GL_VER}/gitleaks_${GL_VER}_linux_x64.tar.gz" \
      && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && rm /tmp/gitleaks.tgz \
      && rm -rf /var/lib/apt/lists/* /root/.cache /opt/nikto/.git; \
    fi
COPY --from=go-builder /arsenal-bin/ /arsenal-bin/
RUN if [ "$WITH_ARSENAL" = "1" ]; then set -eux; \
      [ -n "$(ls -A /arsenal-bin 2>/dev/null)" ] || { echo "go-builder : aucun binaire — WITH_ARSENAL=1 exige un build de l'étage go-builder" >&2; exit 1; }; \
      mv /arsenal-bin/* /usr/local/bin/ && rmdir /arsenal-bin \
      && chmod 0755 /usr/local/bin/subfinder /usr/local/bin/httpx /usr/local/bin/nuclei /usr/local/bin/amass /usr/local/bin/ffuf \
      && nuclei -update-templates || echo "(warning) nuclei -update-templates a échoué — les templates seront téléchargés au premier scan"; \
    fi

# Wordlist ffuf (seclists) — incluse avec WITH_ARSENAL ; chemin surchargeable
# par FFUF_WORDLIST (défaut du moteur : /usr/share/seclists/Discovery/Web-Content/common.txt).
# NB : le paquet Debian « seclists » a disparu de trixie — on clone le dépôt
# amont (même arborescence /usr/share/seclists) et on vérifie le fichier
# attendu par le moteur au boot du build.
ARG WITH_SECLISTS=0
RUN if [ "$WITH_SECLISTS" = "1" ]; then set -eux; \
      git clone --depth 1 https://github.com/danielmiessler/SecLists.git /usr/share/seclists \
      && test -f /usr/share/seclists/Discovery/Web-Content/common.txt \
      && rm -rf /usr/share/seclists/.git; \
    fi

# Nettoyage cosmétique (fin d'étape finale) : `nuclei -update-templates` (P5)
# laisse un résidu LevelDB temporaire dans /tmp pendant le build — purge pour
# que l'image livrée ait un /tmp propre.
RUN rm -rf /tmp/nuclei* || true

# Bun (binaire autonome) + code du moteur (client Prisma généré inclus).
COPY --from=oven/bun:1 /usr/local/bin/bun /usr/local/bin/bun
COPY --from=build /engine /engine

EXPOSE 3030

# BIND_HOST est fourni par docker-compose (0.0.0.0 dans le réseau interne
# compose uniquement — le port n'est jamais publié sur l'hôte).
# exec direct (sans `bun run`) : SIGTERM délivré au processus → arrêt gracieux.
CMD ["bun", "src/index.ts"]

