# ── AuditForge — sidecar de sauvegarde planifiée (P1, suite P0-1) ───────────
# Image minimale : Alpine + CLI sqlite3 + script de sauvegarde P0-1.
# Exécuté par le service `backup` de docker-compose.prod.yml : montage du
# volume SQLite (checkpoint WAL possible) et d'un répertoire hôte pour les
# sauvegardes — la base est copiée FROIDE (intégrité vérifiée), rotation KEEP.
#
# P3 (audit v2) : HEALTHCHECK fondé sur last-backup.json (écrit par le script
# sur chaque tentative, succès OU échec). Le conteneur passe « unhealthy » si :
#   - le statut du dernier essai est « error », ou
#   - le dernier essai date de plus de 2 périodes (BACKUP_INTERVAL_SECONDS) —
#     boucle bloquée, disque plein, cron mort…
# Visible via `docker ps` / `docker inspect` — voir README « Surveillance ».
#
# Variables (déjà posées ci-dessous, surchargables dans le compose) :
#   DB_PATH                 — chemin de la base dans le conteneur (/data/…)
#   BACKUP_DIR              — destination des sauvegardes (/backups)
#   KEEP                    — rotation (défaut 7)
#   BACKUP_INTERVAL_SECONDS — période entre deux sauvegardes (défaut 86400 = 24 h)

FROM alpine:3.20

# bash : le script P0-1 porte le shebang #!/bin/bash (identique au cron hôte) —
# busybox ash ne l'interprète pas (« not found » au lancement du sidecar).
RUN apk add --no-cache sqlite bash

COPY scripts/auditforge-backup.sh /usr/local/bin/auditforge-backup.sh
RUN chmod +x /usr/local/bin/auditforge-backup.sh

ENV DB_PATH=/data/auditforge.db \
    BACKUP_DIR=/backups \
    KEEP=7 \
    BACKUP_INTERVAL_SECONDS=86400

# Healthcheck (busybox sh, sans jq) : statut=ok ET fraîcheur < 2 périodes.
# Start-period 5 min : laisse la première sauvegarde (immédiate au boot)
# s'exécuter avant de compter les échecs.
HEALTHCHECK --interval=60s --timeout=10s --start-period=300s --retries=3 CMD ["/bin/sh", "-c", \
  "f=\"$BACKUP_DIR/last-backup.json\"; \
   [ -f \"$f\" ] || exit 1; \
   ts=$(sed -n 's/.*\"epoch\":\\([0-9]*\\).*/\\1/p' \"$f\"); \
   st=$(sed -n 's/.*\"status\":\"\\([a-z]*\\)\".*/\\1/p' \"$f\"); \
   [ \"$st\" = \"ok\" ] || exit 1; \
   [ -n \"$ts\" ] || exit 1; \
   now=$(date +%s); [ $((now - ts)) -lt $((2 * ${BACKUP_INTERVAL_SECONDS:-86400})) ] || exit 1; exit 0"]

# Boucle simple (pas de crond à configurer) : première sauvegarde immédiate
# au démarrage, puis une par période. Le script est non fatal (`|| true`) :
# un incident (base absente au boot, disque plein…) est journalisé, tracé
# dans last-backup.json (P3) et la boucle repart à la période suivante —
# restart: unless-stopped complète.
ENTRYPOINT ["/bin/sh", "-c", \
  "while true; do /usr/local/bin/auditforge-backup.sh || true; sleep \"${BACKUP_INTERVAL_SECONDS:-86400}\"; done"]
