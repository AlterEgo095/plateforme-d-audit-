// AuditForge - Plateforme d'audit unifiée
// Schéma de persistance (SQLite via Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         String     @default("VIEWER") // ADMIN | AUDITOR | VIEWER
  mfaEnabled   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  campaigns    Campaign[]
  cases        Case[]
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  target      String
  targetType  String // URL | GIT | NETWORK
  profile     String // QUICK | STANDARD | DEEP
  status      String   @default("DRAFT") // DRAFT | RUNNING | COMPLETED | FAILED | CANCELLED
  // P5 : exécution séquentielle (chaîne d'outils) — les scans démarrent l'un
  // après l'autre (recon → DAST → exploitation) au lieu de courir en parallèle.
  sequential  Boolean  @default(false)
  // Sprint 2 : rattachement optionnel à un dossier client (Case) — une
  // campagne liée à un dossier exige une autorisation signée active couvrant
  // la cible pour pouvoir être lancée.
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  scans       Scan[]

  @@index([createdById])
  @@index([createdAt])
  @@index([caseId])
}

model Scan {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tool          String // PHANTOM | DEEPAUDIT | BASALT | REDAMON
  target        String
  status        String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  // REAL | SIMULATION — renseigné par le moteur
  mode          String?
  progress      Int       @default(0)
  phase         String    @default("")
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  findingsCount Int       @default(0)
  criticalCount Int       @default(0)
  createdAt     DateTime  @default(now())
  findings      Finding[]
  logs          ScanLog[]

  // m8 (audit 8-a) : index sur les FK et colonnes de filtrage/trie réelles —
  // ScanLog et Finding croissent sans borne, les requêtes filtrent par scanId.
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model Finding {
  id                String   @id @default(cuid())
  scanId            String
  scan              Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  tool              String
  title             String
  severity          String // CRITICAL | HIGH | MEDIUM | LOW | INFO
  confidence        String // CONFIRMED | PROBABLE | UNVERIFIED
  category          String // injection, xss, auth, crypto, recon, secrets, dos, ...
  cve               String?
  cvss              Float?
  location          String?
  description       String
  evidence          String
  poc               String
  sentinelTriggered Boolean  @default(false)
  status            String   @default("OPEN") // OPEN | CONFIRMED | FALSE_POSITIVE | FIXED
  remediation       String?
  createdAt         DateTime @default(now())

  @@index([scanId])
  @@index([status])
  // P4 : audits profonds → des milliers de constats. Le listing trie par
  // createdAt desc et filtre par sévérité/outil — index dédiés.
  @@index([createdAt])
  @@index([severity])
  @@index([tool])
}

model ScanLog {
  id      Int      @id @default(autoincrement())
  scanId  String
  scan    Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ts      DateTime @default(now())
  level   String // INFO | CMD | WARN | ERROR | SUCCESS | TOOL | AGENT
  source  String
  message String

  @@index([scanId])
  @@index([ts])
  // P4 : index composite (scanId, ts) — le chemin chaud du terminal live et
  // de la relecture des logs d'un scan DEEP (des dizaines de milliers de
  // lignes filtrées par scan et triées par horodatage).
  @@index([scanId, ts])
}

model AuditTrail {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  resource  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Sprint 2 : dossiers client + autorisation de test ───────────────

/**
 * Case — dossier client d'audit. Regroupe des campagnes sous une référence
 * client unique (AF-<année>-<NNN>) et porte le workflow d'autorisation :
 * un lancement de campagne rattachée à un dossier exige une autorisation
 * signée ACTIVE (non révoquée, période valide) couvrant la cible.
 * Statut : OPEN (brouillon) → AUTHORIZED (autorisation signée) →
 * RUNNING (campagne en cours) → REPORTED (rapport client généré) → CLOSED.
 */
model Case {
  id           String   @id @default(cuid())
  reference    String   @unique // AF-2025-001
  title        String
  client       String
  contact      String?
  description  String?
  status       String   @default("OPEN")
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  campaigns    Campaign[]
  authorizations CaseAuthorization[]

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

/**
 * CaseAuthorization — attestation d'autorisation de test signée par le
 * client. Une seule autorisation ACTIVE par période : signée (signedAt),
 * non révoquée (revokedAt null), dans la fenêtre [validFrom, validUntil].
 * `targets` = tableau JSON d'hôtes autorisés (hôte exact ou joker *.domaine,
 * minuscules) — PAS une liste Prisma (SQLite) : sérialisation JSON maîtrisée
 * dans src/lib/case-auth.ts. `signature` = empreinte SHA-256 hexadécimale de
 * l'attestation canonique (preuve d'intégrité affichée dans le rapport).
 */
model CaseAuthorization {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  signatory     String
  signatoryRole String
  scope         String
  targets       String // JSON array — voir ci-dessus
  validFrom     DateTime
  validUntil    DateTime
  signature     String
  signedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([caseId])
}
