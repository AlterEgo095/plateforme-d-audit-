# ── AuditForge — configuration du moteur d'exécution (scan-engine) ──────────
# Copiez ce fichier vers `.env` puis adaptez les valeurs :
#   cp .env.example .env

# Base de données SQLite partagée avec l'application Next.js.
# Chemin relatif résolu depuis mini-services/scan-engine/prisma/schema.prisma ;
# en cas de doute, utilisez un chemin ABSOLU (recommandé).
DATABASE_URL="file:/opt/auditforge/db/custom.db"

# Secret de signature des sessions (HMAC-SHA256) — DOIT être identique à
# celui de l'application Next.js (vérification des handshakes socket.io).
AUTH_SECRET="changez-moi-openssl-rand-hex-32"

# Token interne exigé sur /internal/* (en-tête `x-internal-token`) —
# DOIT être identique à celui de l'application Next.js.
ENGINE_INTERNAL_TOKEN="changez-moi-openssl-rand-hex-32"

# Interface d'écoute HTTP. Défaut : 127.0.0.1 (bouclage, le plus sûr).
# En Docker, mettre 0.0.0.0 — le port n'est alors jamais publié sur l'hôte.
# BIND_HOST=127.0.0.1

# Port d'écoute du moteur. Défaut : 3030.
# PORT=3030
