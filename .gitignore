# ── AuditForge ──────────────────────────────────────────────────────────────

# Dépendances
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Variables d'environnement (NE JAMAIS committer — voir .env.example)
.env
.env.*
!.env.example

# Base de données SQLite (créée par `prisma db push` + seed automatique)
/db/*.db
/db/*.db-shm
/db/*.db-wal
/db/*.db-journal
!/db/.gitkeep

# Journaux
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environnement de développement sandbox (hors périmètre de la plateforme)
/Caddyfile
/skills/
/examples/
/tests/
/tool-results/
/agent-ctx/
/download/
/upload/
/.zscripts/
.z-ai-config
.claude
prompt
local-*
/worklog.md

# Divers
.DS_Store
*.pem
.vercel
/coverage
